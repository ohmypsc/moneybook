{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "moneybook",

  "main": "./worker/index.js",

  "compatibility_date": "2026-08-10",

  "assets": {
    "not_found_handling": "single-page-application",

    "run_worker_first": [
      "/api/*"
    ]
  },

  "secrets": {
    "required": [
      "APPS_SCRIPT_URL",
      "LEDGER_API_SECRET",
      "LOGIN_USERS",
      "SESSION_SECRET"
    ]
  }
}
