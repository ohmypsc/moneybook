{
  "name": "moneybook",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-pwa-icons.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.*",
    "check:worker": "node scripts/check-worker-syntax.mjs",
    "check": "npm run typecheck && npm test && npm run check:worker && npm run check:boundaries",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy --config dist/moneybook/wrangler.json",
    "check:boundaries": "node scripts/check-source-boundaries.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.46.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "wrangler": "4.113.0"
  }
}
